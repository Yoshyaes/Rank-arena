SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Client-side Supabase vars (used by Vite — must be prefixed VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

RAWG_API_KEY=your-rawg-api-key
ADMIN_PASSWORD=your-admin-password

# HMAC secret shared between the WordPress PHP proxy and this server.
# Required for WordPress user identity verification — server will reject
# all WP-authenticated requests if this is not set.
WP_AUTH_SECRET=change-me-to-a-random-secret

# Absolute path to the SQLite database file (default: server/db/arena.db)
SQLITE_PATH=./server/db/arena.db

# Allowed CORS origin — set to your frontend URL (no trailing slash)
ALLOWED_ORIGIN=http://localhost:5173

PORT=3001
NODE_ENV=development
