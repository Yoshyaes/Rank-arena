{
  "name": "rank-arena",
  "version": "1.0.0",
  "description": "Rank Arena — Daily Higher/Lower game for Two Average Gamers",
  "scripts": {
    "dev": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "postbuild": "node scripts/postbuild-copy-dist.mjs",
    "test": "cd client && npx vitest run",
    "test:legacy-server": "npx vitest run --config vitest.config.js",
    "lint": "cd client && npx eslint src/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "vitest": "^4.1.2"
  }
}
